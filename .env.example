APP_NAME=metroGen API
APP_ENV=development
SECRET_KEY=change-me

# Session lifetime in hours. 87600 = 10 years: people sign in once and stay in, by design.
# Revocation is by turning the account off (checked on every request) or by rotating SECRET_KEY.
ACCESS_TOKEN_TTL_HOURS=87600

BOOTSTRAP_ADMIN_FIRST_NAME=Bootstrap
BOOTSTRAP_ADMIN_LAST_NAME=Administrator
BOOTSTRAP_ADMIN_PATRONYMIC=
BOOTSTRAP_ADMIN_EMAIL=admin@metrogen.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
FRONTEND_APP_URL=http://localhost:5174

# Single sign-on (Authentik OIDC). Off unless OIDC_ENABLED=true and a secret is set.
OIDC_ENABLED=false
OIDC_ISSUER=https://auth.mkair-it.ru/application/o/metrogen/
OIDC_CLIENT_ID=metrogen
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://metrogen.mkair-it.ru/api/v1/auth/oidc/callback
OIDC_SCOPES=openid email profile groups
OIDC_AUTO_PROVISION=false
OIDC_COOKIE_SECURE=true

API_HOST=127.0.0.1
API_PORT=8001
API_RELOAD=false
API_LOG_LEVEL=info
FRONTEND_DIST_DIR=frontend/dist
FRONTEND_PORT=5174
POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://metrologenerator:metrologenerator@127.0.0.1:5433/metrologenerator
BACKEND_CORS_ORIGINS=http://localhost:5174
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:8001

ARSHIN_TIMEOUT=30
ARSHIN_CONCURRENCY=2
ARSHIN_RETRY_ATTEMPTS=4
ARSHIN_RETRY_BACKOFF_BASE=0.5
ARSHIN_RETRY_BACKOFF_MAX=5.0
ARSHIN_RETRY_JITTER=0.3
USER_AGENT=arshin-fastapi/0.1

PROTOCOL_BUILD_CONCURRENCY=2
PROTOCOL_RETRY_ATTEMPTS=3
PROTOCOL_RETRY_DELAY=2.0

EXPORTS_DIR=exports
SIGNATURES_DIR=signatures

SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=metroGen Robot
